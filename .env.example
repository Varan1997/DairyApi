PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/dairy_app

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d

# Frontend origins (for CORS + Socket.IO)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5182

# OTP
OTP_EXPIRES_MINUTES=5

# SMS provider: 2Factor.in — get your API key from https://2factor.in dashboard (see utils/sms.js)
TWOFACTOR_API_KEY=
# Only needed if you've registered a DLT-approved template in your 2Factor dashboard
TWOFACTOR_TEMPLATE_NAME=

# Razorpay (get these from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
